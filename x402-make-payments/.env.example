# Payer wallet private key (0x-prefixed 32-byte hex). Use a testnet wallet — never a
# real key with meaningful funds. This is the only value needed for the default stub run.
PRIVATE_KEY=0x...

# Source-chain RPC URL (Base Sepolia). Needed only for real settlement, where the
# client preflights your Permit2 allowance before signing. Leave blank for the stub.
#   RPC_URL=https://sepolia.base.org
RPC_URL=

# Merchant URL defaults to the sibling example at http://localhost:4020/paid.
# Uncomment to point elsewhere.
#   MERCHANT_URL=http://localhost:4020/paid

# Idempotency key for the payment. Set this to a STABLE, per-payment value (e.g. your
# order or invoice id) and REUSE the exact same value if you retry this payment — the payer
# rebuilds the same single-use escrow deposit nonce, so a retry is deduped instead of
# charging twice. Use a DISTINCT value for every different payment. Leave blank only for a
# one-shot demo run (a random, non-retry-safe id is generated). See the README section
# "Avoiding double payments".
#   REQUEST_ID=order-2026-0001
REQUEST_ID=
