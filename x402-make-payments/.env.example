# Payer private key (0x-prefixed 32-byte hex)
# Use a testnet wallet — never a real key with meaningful funds during development.
PRIVATE_KEY=0x...

# URL of the x402-gated resource to request.
# Pair with the sibling x402-accept-payments example (runs on http://localhost:4020).
MERCHANT_URL=http://localhost:4020/paid

# (Optional) Source-chain RPC URL
# When set, the client preflights your Permit2 allowance before signing.
# Leave blank to skip the preflight.
RPC_URL=
