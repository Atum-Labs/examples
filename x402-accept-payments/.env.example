# Merchant server port
PORT=4020

# Facilitator URL — the service that verifies and settles payments.
# Local development: the mock facilitator included in this example.
# Testnet/mainnet: the URL provided by Atum.
FACILITATOR_URL=http://localhost:8091

# Mock facilitator port (only used when running `npm run facilitator`).
MOCK_FACILITATOR_PORT=8091

# Payment gateway URL. When set, the merchant reads the corridor's contract
# addresses (escrow, fulfillment proxy, verifier, roles) from `${GATEWAY_URL}/defaults`
# at startup — you never hand-copy them. Leave UNSET for local mock mode.
# GATEWAY_URL=https://payment-gw.production-testnet.atum.xyz

# --- Corridor (defaults to Base Sepolia USDC -> Tempo Moderato pathUSD) ---

# Source: the chain + token the payer pays FROM.
SOURCE_NETWORK=eip155:84532
SOURCE_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Destination: the chain + token + address you RECEIVE on.
DEST_NETWORK=eip155:42431
DEST_ASSET=0x20C0000000000000000000000000000000000000
DEST_ADDRESS=0xYourMerchantAddressHere

# Amount the merchant receives, in atomic token units (100000 = 0.1 pathUSD at 6 decimals).
FULFILLMENT_AMOUNT=100000

# Markup over FULFILLMENT_AMOUNT, in basis points (100 = 1%), used to derive the
# source-chain spend cap the payer authorizes. Covers settlement fees and
# cross-chain conversion. Leave at 0 for a like-for-like demo.
MARKUP_BPS=0

# Deadline budgets carried into the payment, in seconds.
# Keep QUOTE_DEADLINE_SECONDS short — a long quote budget is rejected by the
# corridor (20s was observed to fail; 5s settles synchronously).
QUOTE_DEADLINE_SECONDS=5
FULFILLMENT_DEADLINE_SECONDS=300
