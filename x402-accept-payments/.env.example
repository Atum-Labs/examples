# ─────────────────────────────────────────────────────────────────────────────
# x402 merchant configuration
#
# Out of the box, src/merchant.ts runs a VERIFIED testnet corridor:
#   Base Sepolia USDC  →  Tempo (Moderato) pathUSD
# You only NEED to set USE_STUB_FACILITATOR and — for real settlement — DEST_ADDRESS.
# The corridor menu further down is OPTIONAL: uncomment a pair to switch corridors.
# ─────────────────────────────────────────────────────────────────────────────

# Settlement mode — the one value most users touch.
#   true  — local stub: full 402 → pay → 200 flow, no facilitator/gateway/funds (default)
#   false — settle through a real Atum x402 facilitator (needs a funded payer + DEST_ADDRESS below)
USE_STUB_FACILITATOR=true

# Your receiving address on the destination chain.
# Required only when USE_STUB_FACILITATOR=false.
DEST_ADDRESS=0xYourMerchantAddressHere


# ─── Corridor (optional) ─────────────────────────────────────────────────────
# The merchant accepts payment on a SOURCE (network + token) and delivers on a
# DEST (network + token). The corridor's CONTRACT ADDRESSES (escrow, fulfillment
# proxy, reserver, releaser, verifier) are NOT configured here — the merchant
# resolves them from the gateway's GET /defaults at startup, so they can't go stale.
#
# To switch corridors: uncomment ONE source pair AND ONE dest pair below. Each is
# a CAIP-2 network id + the bare token contract address, copied verbatim from
# https://docs.atumlabs.xyz/get-started/reference/supported-assets
#
# Notes:
#  • This example signs with EVM keys (ethers + Permit2), so only EVM networks are
#    listed. Solana / Tron sources aren't supported by this client.
#  • Not every source×dest pair has settlement coverage. If a corridor returns
#    QUOTE_DEADLINE_EXPIRED, that pair isn't covered yet — contact us.
#  • Cross-chain to a slow chain (e.g. Tempo) may settle slower than x402 can
#    confirm synchronously; a same-VM corridor settles more reliably in-window.
#  • All tokens below are 6-decimal, so FULFILLMENT_AMOUNT=50000 stays 0.05.
#  • For USDT / PYUSD / rUSD variants of these chains, see the link above.
#
# Leaving these commented uses the default: Base Sepolia USDC → Tempo pathUSD.

# ── SOURCE — what the payer funds from (USDC shown) ──
# Base Sepolia · USDC   (default)
# SOURCE_NETWORK=eip155:84532
# SOURCE_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Arbitrum Sepolia · USDC
# SOURCE_NETWORK=eip155:421614
# SOURCE_ASSET=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Optimism Sepolia · USDC
# SOURCE_NETWORK=eip155:11155420
# SOURCE_ASSET=0x5fd84259d66Cd46123540766Be93DFE6D43130D7
# Ethereum Sepolia · USDC
# SOURCE_NETWORK=eip155:11155111
# SOURCE_ASSET=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Celo Sepolia · USDC
# SOURCE_NETWORK=eip155:11142220
# SOURCE_ASSET=0x01C5C0122039549AD1493B8220cABEdD739BC44E
# Polygon Amoy · USDC
# SOURCE_NETWORK=eip155:80002
# SOURCE_ASSET=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
# Avalanche Fuji · USDC
# SOURCE_NETWORK=eip155:43113
# SOURCE_ASSET=0x5425890298aed601595a70AB815c96711a31Bc65

# ── DEST — what the merchant receives ──
# Tempo Moderato · pathUSD   (default, verified)
# DEST_NETWORK=eip155:42431
# DEST_ASSET=0x20C0000000000000000000000000000000000000
# Base Sepolia · USDC
# DEST_NETWORK=eip155:84532
# DEST_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Arbitrum Sepolia · USDC
# DEST_NETWORK=eip155:421614
# DEST_ASSET=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Optimism Sepolia · USDC
# DEST_NETWORK=eip155:11155420
# DEST_ASSET=0x5fd84259d66Cd46123540766Be93DFE6D43130D7


# Everything else (amount, markup, deadlines, gateway/facilitator URLs) has working
# testnet defaults in src/merchant.ts. See the README to override them.
