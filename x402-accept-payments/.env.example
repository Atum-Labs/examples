# Merchant server port
PORT=4020

# Facilitator URL
# For local development, use the mock facilitator included in this example.
# For testnet/mainnet, replace with the URL provided by Atum.
FACILITATOR_URL=http://localhost:8091

# Mock facilitator port (only used when running npm run facilitator)
MOCK_FACILITATOR_PORT=8091

# Corridor config — the source chain your merchant accepts payment from.
SOURCE_NETWORK=eip155:8453
SOURCE_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Corridor config — where your merchant receives funds.
DEST_NETWORK=eip155:42161
DEST_ASSET=0x52e52f345139e57b87d288c9ea794bb3fbe591c3
DEST_ADDRESS=0xYourMerchantAddressHere

# Amount the merchant receives, in atomic token units (e.g. 10000000 = 10 USDC).
FULFILLMENT_AMOUNT=10000000

# Markup over FULFILLMENT_AMOUNT, in basis points (100 = 1%), used to derive the
# source-chain spend cap the payer authorizes. Covers settlement fees and
# cross-chain conversion. Leave at 0 for a like-for-like demo.
MARKUP_BPS=0

# Corridor configuration — provided by Atum for your corridor.
# Contract addresses:
ESCROW_CONTRACT=0xYourEscrowContractHere
FULFILLMENT_PROXY=0xYourFulfillmentProxyHere
RESERVER=0xYourReserverHere
RELEASER=0xYourReleaserHere
# Fulfillment verifier endpoint (a URL, not an address):
VERIFIER_ENDPOINT=http://localhost:8080/veri-fill
