{
  "name": "x402-accept-payments",
  "version": "0.1.0",
  "description": "Example merchant server for accepting x402 (atum-escrow) payments",
  "private": true,
  "scripts": {
    "dev": "concurrently -n facilitator,merchant -c cyan,green \"tsx src/mock-facilitator.ts\" \"tsx src/merchant.ts\"",
    "merchant": "tsx src/merchant.ts",
    "facilitator": "tsx src/mock-facilitator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
