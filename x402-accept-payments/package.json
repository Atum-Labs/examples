{
  "name": "x402-accept-payments",
  "version": "0.1.0",
  "description": "Example merchant server for accepting x402 (atum-escrow) payments",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/merchant.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "tsx --test --test-name-pattern=real.e2e src/*.test.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
