# Payer private key (0x-prefixed 32-byte hex).
# Use a testnet wallet — never a real key with meaningful funds during development.
PRIVATE_KEY=0x...

# URL of the MPP-gated resource to request.
# Pair with the sibling mpp-accept-payments example (runs on http://localhost:4030).
MERCHANT_URL=http://localhost:4030/paid

# Source-chain RPC URL — Base Sepolia for this corridor.
# When set, the client approves the source token (Permit2) before paying, so the
# escrow deposit does not revert at settlement. Leave blank against the stub merchant.
RPC_URL=https://sepolia.base.org
