# ─────────────────────────────────────────────────────────────────────────────
# Session token (testnet)
#
# A stub run needs none of this: `npm run token` starts an in-process authorization
# service and gateway, signs with a throwaway wallet, and never leaves the machine.
# ─────────────────────────────────────────────────────────────────────────────

# Mode — the one value most users touch.
#   true  — local stub: nonce → signed presentation → token → a gateway call, offline (default)
#   false — request a real session token (needs PRIVATE_KEY and CREDENTIAL_FILE below)
USE_STUB_AUTH=true

# The private key of the wallet your Known to Atum credential is issued to (0x-prefixed
# 32-byte hex). It signs the session presentation; it never leaves this process.
#
# LEAVE THIS UNSET for a stub run: the client generates a throwaway wallet per run.
# Required when USE_STUB_AUTH=false. Never commit it.
# PRIVATE_KEY=

# Path to your Known to Atum credential, the JSON Atum issued to that wallet during
# onboarding. Required when USE_STUB_AUTH=false. `credential.json` is gitignored.
# CREDENTIAL_FILE=./credential.json

# ─── Endpoints ───────────────────────────────────────────────────────────────
# Used when USE_STUB_AUTH=false. Ignored by the stub. Both must be the same environment
# as your credential: a testnet credential is not valid on mainnet.
# AUTH_URL=https://auth.production-testnet.atum.xyz
# GATEWAY_URL=https://payment-gw.production-testnet.atum.xyz
