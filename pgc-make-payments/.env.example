# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateway client (testnet)
#
# The active corridor below is Base Sepolia USDC → Tempo (Moderato) pathUSD.
# A stub run needs none of this: `npm run pay` starts an in-process gateway,
# signs offline, and never touches a chain.
# ─────────────────────────────────────────────────────────────────────────────

# Settlement mode — the one value most users touch.
#   true  — local stub: prepare → sign → submit → collect, no gateway/funds (default)
#   false — settle through a real Atum payment gateway (needs a funded PRIVATE_KEY
#           and DEST_ADDRESS below)
USE_STUB_GATEWAY=true

# Payer private key (0x-prefixed 32-byte hex).
#
# LEAVE THIS UNSET for a stub run: the payment is signed offline and never touches a
# chain, so the client generates a throwaway key per run and prints its address.
#
# Set it for real settlement — a funded testnet key you control, never a key with
# meaningful funds. Uncomment and paste your own; a placeholder value here is worse
# than no value, because it overrides the generated key with something invalid.
# PRIVATE_KEY=

# Your receiving address on the destination chain.
# Required only when USE_STUB_GATEWAY=false.
# DEST_ADDRESS=0xYourReceivingEOA

# Source-chain RPC URL (Base Sepolia). Needed only for real settlement, where the
# client approves the source token (Permit2) before signing. Leave blank for the stub.
#   RPC_URL=https://sepolia.base.org
RPC_URL=

# ─── Corridor ────────────────────────────────────────────────────────────────
# The SOURCE is the network + token the payer funds from; the DEST is what the
# receiver gets. The corridor's CONTRACT ADDRESSES (escrow, fulfillment proxy,
# quote selector, verifier) are NOT set here — preparePaymentRequest reads them
# from the gateway's GET /defaults, so they can't drift.
#
# Values are a CAIP-2 network id + the bare token address, from
# https://docs.atum.xyz/get-started/reference/supported-assets
#
# To reverse direction, comment the active block and uncomment the alternative.

# Base Sepolia · USDC  ->  Tempo Moderato · pathUSD   (active default)
SOURCE_NETWORK=eip155:84532
SOURCE_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DEST_NETWORK=eip155:42431
DEST_ASSET=0x20c0000000000000000000000000000000000000

# Alternative — Tempo Moderato · pathUSD  ->  Base Sepolia · USDC
# SOURCE_NETWORK=eip155:42431
# SOURCE_ASSET=0x20c0000000000000000000000000000000000000
# DEST_NETWORK=eip155:84532
# DEST_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Exact amount the destination receives, in atomic units of the dest token.
# Default 50000 = 0.05 of a 6-decimal token (e.g. Tempo pathUSD).
# FULFILLMENT_AMOUNT=50000

# ─── Endpoints ───────────────────────────────────────────────────────────────
# Real settlement is pointed at staging-testnet until production-testnet is on
# the v4 contracts this client is drafted against. Ignored by the stub.
# GATEWAY_URL=https://payment-gw.staging-testnet.atumlabs.xyz

# ─── Demo: watch a slow settlement resolve ───────────────────────────────────
# How many status checks the STUB reports as still settling before it settles.
# Set it to see waitForTerminalStatus collect the outcome — the path a real
# cross-chain settlement takes when it outruns the gateway's ~30s window.
#   STUB_PENDING_ATTEMPTS=2

# There is deliberately no REQUEST_ID here. Each run generates and prints a fresh
# request id, so every run is a new payment. Pass it on the command line only to
# re-attempt a payment that was interrupted while still settling:
#   REQUEST_ID=<the id the run printed> npm run pay
# Setting it here instead would make every run re-attempt the same payment.
