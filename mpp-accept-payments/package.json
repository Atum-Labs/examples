{
  "name": "mpp-accept-payments",
  "version": "0.1.0",
  "description": "Example merchant server that accepts MPP (Machine Payments Protocol) payments using Atum's atum-escrow method",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/merchant.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "tsx --test --test-name-pattern=real.e2e src/*.test.ts"
  },
  "dependencies": {
    "@atumlabs/mppx-atum-escrow": "0.7.0",
    "@atumlabs/payment-gateway-client": "5.0.0",
    "mppx": "0.8.12",
    "zod": "4.6.5",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "6.29.0",
    "viem": "2.56.8"
  }
}
