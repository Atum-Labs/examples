# Merchant server port
PORT=4030

# Settlement mode.
#   true  — local stub, runs the full flow with no gateway or funds (default)
#   false — settle through a real Atum Payment Gateway (needs GATEWAY_URL + a funded payer)
USE_STUB_SUBMITTER=true

# Payment Gateway base URL (used when USE_STUB_SUBMITTER=false). The corridor's escrow,
# role, proxy, and verifier addresses are fetched from here automatically — you don't set them.
GATEWAY_URL=https://payment-gateway-testnet.atumlabs.xyz

# mppx realm and HMAC secret (>= 32 bytes). Use a real secret in production.
REALM=mpp.example.com
MPP_SECRET_KEY=dev-only-change-me-mpp-atum-escrow-secret-0123456789

# Exact amount the merchant receives, in atomic token units (e.g. 100000 = 0.10 of a 6-decimal token).
FULFILLMENT_AMOUNT=100000

# Markup over FULFILLMENT_AMOUNT, in basis points (100 = 1%), used to derive the
# source spend cap the payer authorizes. Covers settlement fees and cross-chain conversion.
MARKUP_BPS=300

# Deadline budgets (seconds), relative to signing time. quote must be < fulfillment.
QUOTE_DEADLINE_SECONDS=60
FULFILLMENT_DEADLINE_SECONDS=600

# Where the merchant receives funds.
DEST_NETWORK=eip155:11142220
DEST_ASSET=0xYourDestinationTokenHere
DEST_ADDRESS=0xYourMerchantAddressHere

# The source chain/token the merchant accepts payment from.
SOURCE_NETWORK=eip155:421614
SOURCE_ASSET=0xYourSourceTokenHere
