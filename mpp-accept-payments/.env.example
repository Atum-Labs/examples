# Merchant server port
PORT=4030

# Settlement mode.
#   true  — local stub, runs the full flow with no gateway or funds (default)
#   false — settle through a real Atum Payment Gateway (needs a funded payer; the gateway URL has a testnet default)
USE_STUB_SUBMITTER=true

# Payment Gateway base URL. Defaults (in src/merchant.ts) to the testnet endpoint shown
# below, so you don't need to set it for testnet; the corridor's escrow, role, proxy, and
# verifier addresses are fetched from here automatically. For mainnet — where authorized by
# Atum — uncomment and replace with the production gateway Atum provides.
# GATEWAY_URL=https://payment-gw.production-testnet.atum.xyz

# mppx realm and HMAC secret (>= 32 bytes). The default secret below is a public
# placeholder (it ships in this repo) and is only safe for the local stub flow —
# the server refuses to start with it once USE_STUB_SUBMITTER=false. Generate a
# real, private one with `openssl rand -hex 32` before accepting real payments.
REALM=mpp.example.com
MPP_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# Exact amount the merchant receives, in atomic token units (e.g. 50000 = 0.05 of a 6-decimal token).
FULFILLMENT_AMOUNT=50000

# Markup over FULFILLMENT_AMOUNT, in basis points (100 = 1%), used to derive the
# source spend cap the payer authorizes. Covers settlement fees and cross-chain conversion.
MARKUP_BPS=300

# Deadline budgets (seconds), relative to signing time. quote must be < fulfillment.
QUOTE_DEADLINE_SECONDS=5
FULFILLMENT_DEADLINE_SECONDS=60

# Your receiving address on the destination chain. Required only when
# USE_STUB_SUBMITTER=false — the server refuses to start in real mode without a valid one.
DEST_ADDRESS=0xYourMerchantAddressHere


# ─── Corridor ────────────────────────────────────────────────────────────────
# The SOURCE is the network + token the payer funds from; the DEST is what the
# merchant receives. The corridor's CONTRACT ADDRESSES (escrow, roles, fulfillment
# proxy, verifier) are NOT set here — corridorFromDefaults resolves them from the
# gateway's /defaults at startup, so they can't drift. Values are a CAIP-2 network id
# + the bare token address, from
# https://docs.atumlabs.xyz/get-started/reference/supported-assets
# (Tempo has no USDC; pathUSD is its canonical 6-decimal test stablecoin.)
#
# To reverse direction, comment the active block and uncomment the alternative.
# Note: unlike x402, the MPP merchant polls the gateway for the async tail, so a slower
# cross-chain corridor still settles to a confirmed result — see the README.

# Base Sepolia · USDC  ->  Tempo Moderato · pathUSD   (active default)
SOURCE_NETWORK=eip155:84532
SOURCE_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DEST_NETWORK=eip155:42431
DEST_ASSET=0x20c0000000000000000000000000000000000000

# Alternative — Tempo Moderato · pathUSD  ->  Base Sepolia · USDC
# SOURCE_NETWORK=eip155:42431
# SOURCE_ASSET=0x20c0000000000000000000000000000000000000
# DEST_NETWORK=eip155:84532
# DEST_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
